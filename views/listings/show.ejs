<% layout("/layouts/boilerplate") %>

<body>

  <div class="row mt-3">

    <div class="col-8 offset-3">
      <h3><%= listing.title %></h3>
    </div>

    <div class="card col-6 offset-3 show-card listing-card">

      <img
        src="<%= listing.image %>"
        class="card-img-top show-img"
        alt="listingImage"
      />

      <br />

      <div class="card-body">

        <p class="card-text">
          <i>
            Owned By :
            <%= listing.owner ? listing.owner.username : "Unknown" %>
          </i>
        </p>

        <p class="card-text">
          <b>Description : </b>
          <%= listing.description %>
        </p>

        <p class="card-text">
          <b>Title : </b>
          <%= listing.title %>
        </p>

        <p class="card-text">
          <b>Price : </b>
          &#8377;
          <%= listing.price.toLocaleString('en-IN') %>
        </p>

        <p class="card-text">
          <b>Location : </b>
          <%= listing.location %>
        </p>

        <p class="card-text">
          <b>Country : </b>
          <%= listing.country %>
        </p>

      </div>
    </div>
  </div>


  <!-- EDIT AND DELETE BUTTONS -->

  <div class="btns">

    <a
      class="btn btn-dark offset-3 edit-btn"
      href="/listings/<%= listing._id %>/edit"
    >
      Edit
    </a>

    <form
      method="POST"
      action="/listings/<%= listing._id %>?_method=DELETE"
    >
      <button class="btn btn-dark offset-5">
        DELETE
      </button>
    </form>

  </div>


  <br />
  <br />


  <!-- REVIEW SECTION -->

  <div class="col-8 offset-3 mb-3">

    <h4>Leave a Review</h4>

    <!--
      The form must use multipart/form-data so that
      image and video files can be uploaded along with the review.
    -->
    <form
      action="/listings/<%= listing._id %>/reviews"
      method="POST"
      enctype="multipart/form-data"
      novalidate
      class="needs-validation"
    >

      <div class="mb-3 mt-3">

        <label for="rating" class="form-label">
          Rating
        </label>

        <input
          type="range"
          min="1"
          max="5"
          id="rating"
          name="review[rating]"
          class="form-range"
        />

      </div>


      <div class="mb-3 mt-3">

        <label for="comment" class="form-label">
          Comments
        </label>

        <textarea
          name="review[comment]"
          id="comment"
          cols="30"
          rows="10"
          class="form-control"
          required
        ></textarea>

        <div class="invalid-feedback">
          Please Add some comments for review
        </div>

      </div>

      <div class="mb-3 mt-3">

        <label for="images" class="form-label">
          Add Images (optional, up to 5)
        </label>

        <input
          type="file"
          name="images"
          id="images"
          class="form-control"
          accept="image/*"
          multiple
        />

        <div class="form-text">
          You can upload photos of your stay (jpeg, png, gif, webp).
        </div>

      </div>

      <div class="mb-3 mt-3">

        <label for="videos" class="form-label">
          Add Videos (optional, up to 2)
        </label>

        <input
          type="file"
          name="videos"
          id="videos"
          class="form-control"
          accept="video/*"
          multiple
        />

        <div class="form-text">
          You can upload short videos of your stay (mp4, webm, ogg, mov).
        </div>

      </div>

      <button class="btn btn-outline-dark">
        Submit
      </button>

    </form>


    <hr />

    <p>
      <b>All Reviews</b>
    </p>


    <div class="row">

      <% for(review of listing.reviews){ %>

        <div class="card col-5 ms-3 mb-3">

          <div class="card-body">

            <h5 class="card-title">
              <%= review.author ? review.author.username : "Unknown" %>
            </h5>

            <p class="card-text">
              <%= review.comment %>
            </p>

            <p class="card-text">
              <%= review.rating %>
              <b>Stars</b>
            </p>

            <!-- Review Images -->
            <% if(review.images && review.images.length > 0){ %>

              <div class="review-media">

                <% for(let image of review.images){ %>

                  <img
                    src="<%= image.url %>"
                    alt="Review Image"
                    class="review-img"
                  />

                <% } %>

              </div>

            <% } %>

            <!-- Review Videos -->
            <% if(review.videos && review.videos.length > 0){ %>

              <div class="review-media">

                <% for(let video of review.videos){ %>

                  <video
                    src="<%= video.url %>"
                    controls
                    class="review-video"
                  ></video>

                <% } %>

              </div>

            <% } %>

            <form
              action="/listings/<%= listing._id %>/reviews/<%= review._id %>?_method=DELETE"
              method="POST"
              class="mb-3"
            >

              <button class="btn btn-sm btn-dark">
                DELETE
              </button>

            </form>

          </div>

        </div>

      <% } %>

    </div>

  </div>

</body>